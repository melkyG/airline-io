			"type": "shell",
			"command": "node",
			"args": [
				"-e",
				"const H=60*60*1000, HD=24, DM=30, DY=DM*12; const pad=(v)=>String(Math.max(0, Number(v)||0)).padStart(2,'0'); const f=(elapsedMs)=>{const h=Math.floor(Math.max(0,elapsedMs)/H); const d=Math.floor(h/HD); const hour=h%HD; if(d<DM){return `Day ${pad(d+1)}, Hour ${pad(hour)}`;} if(d<DY){const m=Math.floor(d/DM); const dom=(d%DM)+1; return `Month ${m}, Day ${pad(dom)}, Hour ${pad(hour)}`;} const y=Math.floor(d/DY); const yoff=d%DY; const m=Math.floor(yoff/DM)+1; const dom=(yoff%DM)+1; return `Year ${y}, Month ${m}, Day ${pad(dom)}, Hour ${pad(hour)}`;}; [[0,'start'],[2*H,'+2h'],[24*H,'+24h'],[30*24*H,'+30d']].forEach(([ms,n])=>console.log(n+': '+f(ms)));"
			],
			"isBackground": false
