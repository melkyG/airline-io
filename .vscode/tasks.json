		{
			"label": "diagnose-great-circle-routes",
			"type": "shell",
			"command": "node",
			"args": [
				"-e",
				"const { AIRPORT_CATALOG } = require('./server/airports/catalog'); const { calculateRouteDistanceKm } = require('./server/routes'); const { buildGreatCircleRouteSegments } = require('./client/routeGeometry'); const byId = new Map(AIRPORT_CATALOG.map(a=>[a.id,a])); function toRad(d){return d*Math.PI/180;} function angDeg(a,b){const oLat=toRad(a.lat), oLng=toRad(a.lng), dLat=toRad(b.lat), dLng=toRad(b.lng); const ox=Math.cos(oLat)*Math.cos(oLng), oy=Math.cos(oLat)*Math.sin(oLng), oz=Math.sin(oLat); const dx=Math.cos(dLat)*Math.cos(dLng), dy=Math.cos(dLat)*Math.sin(dLng), dz=Math.sin(dLat); const dot=Math.max(-1,Math.min(1,ox*dx+oy*dy+oz*dz)); return Math.acos(dot)*180/Math.PI; } function analyze(idA,idB){const a=byId.get(idA), b=byId.get(idB); const segs=buildGreatCircleRouteSegments({lat:a.lat,lng:a.lng},{lat:b.lat,lng:b.lng}); const pts=segs.flat(); let maxLat=-Infinity,minLat=Infinity; for(const p of pts){maxLat=Math.max(maxLat,p[1]); minLat=Math.min(minLat,p[1]);} let hasJump=false, maxAbsDelta=0; for(const seg of segs){ for(let i=1;i<seg.length;i++){ const d=Math.abs(seg[i][0]-seg[i-1][0]); maxAbsDelta=Math.max(maxAbsDelta,d); if(d>180.000001) hasJump=true; }} const crossesAntimeridian = segs.length>1 || segs.some(seg=>seg.some(p=>Math.abs(Math.abs(p[0])-180)<1e-9)); const rawDelta=Math.abs(b.lng-a.lng); console.log(JSON.stringify({route:`${idA}->${idB}`,origin:{id:a.id,lat:a.lat,lng:a.lng},destination:{id:b.id,lat:b.lat,lng:b.lng},distanceKm:calculateRouteDistanceKm(a,b),angularSeparationDeg:angDeg(a,b),rawAbsLngDelta:rawDelta,sampledMaxLat:maxLat,sampledMinLat:minLat,segments:segs.length,points:pts.length,crossesAntimeridian,hasLargeLngJumpWithinSegment:hasJump,maxAbsLngDeltaWithinSegment:maxAbsDelta,firstPoint:pts[0],lastPoint:pts[pts.length-1]})); }\nanalyze('JFK','HND'); analyze('JFK','LAX'); analyze('HND','ANC'); analyze('YYZ','JFK');"
			],
			"isBackground": false
		}
	]
}