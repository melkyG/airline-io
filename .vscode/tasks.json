			"label": "check-simulation-hud-boundaries",
			"type": "shell",
			"command": "node",
			"args": [
				"-e",
				"const H=60*60*1000, HD=24, DM=30, MY=12, DY=DM*MY; const f=(elapsedMs)=>{const totalElapsedHours=Math.floor(Math.max(0,elapsedMs)/H); const elapsedCompleteDays=Math.floor(totalElapsedHours/HD); const hourOfDay=totalElapsedHours%HD; if(elapsedCompleteDays<DM){return `Day ${elapsedCompleteDays+1}, Hour ${hourOfDay}`;} if(elapsedCompleteDays<DY){const monthNumber=Math.floor(elapsedCompleteDays/DM); const dayOfMonth=(elapsedCompleteDays%DM)+1; return `Month ${monthNumber}, Day ${dayOfMonth}, Hour ${hourOfDay}`;} const yearNumber=Math.floor(elapsedCompleteDays/DY); const dayOffsetInYear=elapsedCompleteDays%DY; const monthOfYear=Math.floor(dayOffsetInYear/DM)+1; const dayOfMonth=(dayOffsetInYear%DM)+1; return `Year ${yearNumber}, Month ${monthOfYear}, Day ${dayOfMonth}, Hour ${hourOfDay}`; }; const cases=[[0,'start'],[5*H,'+5h'],[23*H,'+23h'],[24*H,'+24h'],[30*24*H,'+30d']]; cases.forEach(([ms,name])=>console.log(name+': '+f(ms)));"
			],
			"isBackground": false
		},
